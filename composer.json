{
    "name": "doss/laravel-db-backup",
    "description": "Back up your Laravel database and upload it to Google Drive, S3, FTP or any storage with `php artisan db:backup`.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "backup", "database", "google-drive", "s3", "pg_dump", "mysqldump"],
    "authors": [
        {
            "name": "dossmedaziz",
            "email": "dossaziz4@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "google/apiclient": "^2.15",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "symfony/process": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Doss\\DbBackup\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Doss\\DbBackup\\DbBackupServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
